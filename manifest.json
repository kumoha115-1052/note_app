
{
  "id": "./",
  "name": "Memo - シンプルなメモ帳",
  "short_name": "Memo",
  "description": "端末内にメモを保存できるメモ帳",
  "lang": "ja",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2457d6"
}

/* JSONバックアップの読み込み */
$("importBtn").addEventListener("click", () => {
  $("importFile").click();
});

$("importFile").addEventListener("change", async event => {
  const file = event.target.files[0];
  if (!file) return;

  flushSave();

  try {
    const text = await file.text();
    const data = JSON.parse(text);

    // エクスポート形式を確認
    if (
      !data ||
      !Array.isArray(data.memos)
    ) {
      throw new Error("形式が違います");
    }

    const validMemos = data.memos.filter(memo =>
      memo &&
      typeof memo.title === "string" &&
      typeof memo.content === "string"
    );

    if (validMemos.length === 0) {
      alert("読み込めるメモがありません。");
      return;
    }

    const existingIds = new Set(memos.map(m => m.id));
    let importedCount = 0;
    let skippedCount = 0;

    const confirmed = confirm(
      validMemos.length + "件のメモを読み込みます。\n" +
      "既存のメモは削除・上書きしません。\n" +
      "続けますか？"
    );

    if (!confirmed) return;

    validMemos.forEach(item => {
      // 同じIDのメモは重複登録しない
      if (item.id && existingIds.has(item.id)) {
        skippedCount++;
        return;
      }

      const now = Date.now();

      memos.push({
        id: item.id || (
          now.toString(36) +
          Math.random().toString(36).slice(2)
        ),
        title: item.title,
        content: item.content,
        created: Number(item.created) || now,
        updated: Number(item.updated) || now
      });

      if (item.id) existingIds.add(item.id);
      importedCount++;
    });

    saveData();
    renderList();

    if (memos.length) {
      memos.sort((a, b) => b.updated - a.updated);
      selectMemo(memos[0].id);
    }

    alert(
      "読み込み完了\n" +
      "追加：" + importedCount + "件\n" +
      "重複のためスキップ：" + skippedCount + "件"
    );
  } catch {
    alert(
      "ファイルを読み込めませんでした。\n" +
      "このメモ帳からエクスポートしたJSONファイルを選んでください。"
    );
  } finally {
    event.target.value = "";
  }
});
